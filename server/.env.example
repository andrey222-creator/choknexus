# Copie para .env (nunca commitar o .env real).

ARIUS_DB_USER=
ARIUS_DB_PASSWORD=
ARIUS_DB_CONNECT_STRING=
ARIUS_DB_SCHEMA=PROREG

PORT=3311

# Opcional: caminho absoluto do JSON privado gerado pelo projeto Vendas
